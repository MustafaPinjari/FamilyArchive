# ==========================================
# Family Archive - Google Drive Configuration (100% Free)
# ==========================================
# 1. Go to Google Cloud Console (https://console.cloud.google.com/)
# 2. Create a free project and enable "Google Drive API"
# 3. Create a Service Account under IAM & Admin -> Service Accounts
# 4. Create & download a JSON key for the service account
# 5. In your personal Google Drive, create a folder (e.g., "Family Archive")
# 6. Share that folder with your service account email as "Editor"
# 7. Copy the Folder ID from the URL (the string after /folders/...)

# Option A: Service Account (Recommended - 100% Free & Headless)
GOOGLE_SERVICE_ACCOUNT_EMAIL="your-service-account@your-project-id.iam.gserviceaccount.com"
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Or alternatively place your downloaded service-account.json in the project root:
# GOOGLE_SERVICE_ACCOUNT_KEY_FILE="./service-account.json"

# Target Google Drive Folder ID
GOOGLE_DRIVE_FOLDER_ID="your_folder_id_here"

# Option B: OAuth2 (Alternative)
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# GOOGLE_REFRESH_TOKEN=""
